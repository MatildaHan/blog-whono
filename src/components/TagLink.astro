---
import { getTagSearchPath } from '../lib/tags';
import { createWithBase } from '../utils/format';

const { tag, label = `#${tag}`, class: className = 'tag' } = Astro.props as {
  tag: string;
  label?: string;
  class?: string;
};
const path = getTagSearchPath(tag);
const withBase = createWithBase(import.meta.env.BASE_URL ?? '/');
---

{path ? (
  <a class:list={[className, 'tag-link']} href={withBase(path)} aria-label={`查看标签 ${label} 的内容`}>{label}</a>
) : <span class={className}>{label}</span>}
