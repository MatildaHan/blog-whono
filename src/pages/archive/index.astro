---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEssayStats, getVisibleEssays } from '../../lib/content';
import { getThemeSettings } from '../../lib/theme-settings';
import '../../styles/statistics.css';

const essays = await getVisibleEssays({ includeDraft: false });
const { articleCount, wordCount } = getEssayStats(essays);
const { settings: { page } } = getThemeSettings();
const pageTitle = page.archive.title || '统计';
const numberFormatter = new Intl.NumberFormat('zh-CN');
const description = `本站一共发布了 ${articleCount} 篇文章，共计 ${numberFormatter.format(wordCount)} 字。`;
---

<BaseLayout title={pageTitle} description={description} activeNavId="archive">
  <header class="page-header">
    <h1 class="page-title">{pageTitle}</h1>
  </header>
  <p class="site-statistics">
    <span>本站一共发布了 <strong data-stat-articles>{numberFormatter.format(articleCount)}</strong> 篇文章，</span>
    <span>共计 <strong data-stat-words>{numberFormatter.format(wordCount)}</strong> 字。</span>
  </p>
</BaseLayout>
