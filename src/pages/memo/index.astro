---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getThemeSettings } from '../../lib/theme-settings';
import { getMemoYearPath, getVisibleMemoYears } from '../../lib/memo-years';
import { createWithBase } from '../../utils/format';
import '../../styles/memo.css';

const entries = getVisibleMemoYears(await getCollection('memo'), !import.meta.env.PROD);
const { settings: { page } } = getThemeSettings();
const title = page.memo.title ?? '纪年';
const subtitle = page.memo.subtitle ?? '';
const withBase = createWithBase(import.meta.env.BASE_URL);
// Preserve bookmarks into the original single page after introducing the index.
const legacyEntry = entries.find((entry) => entry.id === 'index');
const legacyHeadings = legacyEntry ? (await render(legacyEntry)).headings.map((heading) => heading.slug) : [];
const legacyHref = legacyEntry ? withBase(getMemoYearPath(legacyEntry.data.year)) : null;
---

<BaseLayout title={title} description={subtitle} bodyClass="memo-index-page" activeNavId="memo" allowReadingMode={false}>
  <div class="page-header">
    <h1 class="page-title">{title}</h1>
    {subtitle ? <span class="page-subtitle">{subtitle}</span> : null}
  </div>

  <p class="memo-index-intro">日子一天接一天地过。<br />记下来，留个备份。</p>

  <ul class="memo-years" aria-label="年度纪年">
    {entries.map((entry) => (
      <li>
        <a class="memo-year" href={withBase(getMemoYearPath(entry.data.year))}>
          <span class="memo-year-number">{entry.data.year}<span class="memo-year-unit">年</span></span>
          <span class="memo-year-copy">
            <span class="memo-year-description">{entry.data.description}</span>
            <span class="memo-year-meta">{entry.data.year} 年纪年{entry.data.draft ? ' · 草稿' : ''}</span>
          </span>
          <span class="memo-year-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
  {entries.length === 0 ? <p class="memo-empty">还没有公开的纪年。</p> : null}

  <script is:inline define:vars={{ legacyHeadings, legacyHref }}>
    const redirectLegacyMemoAnchor = () => {
      if (!legacyHref || !window.location.hash) return;
      let slug = '';
      try { slug = decodeURIComponent(window.location.hash.slice(1)); } catch (_) {}
      if (legacyHeadings.includes(slug)) window.location.replace(legacyHref + window.location.hash);
    };
    redirectLegacyMemoAnchor();
    window.addEventListener('hashchange', redirectLegacyMemoAnchor);
  </script>
</BaseLayout>
